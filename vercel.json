{
  "headers": [
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/debug", "destination": "/debug.html" },
    { "source": "/confirm-email", "destination": "/confirm-email.html" },
    { "source": "/reff/:username", "destination": "/register.html?ref=:username" },
    { "source": "/ref/:username", "destination": "/register.html?ref=:username" },
    { "source": "/reff", "destination": "/register.html" },
    { "source": "/ref", "destination": "/register.html" }
  ]
}
